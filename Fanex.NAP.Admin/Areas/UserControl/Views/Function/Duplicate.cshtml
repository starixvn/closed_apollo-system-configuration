@using Fanex.NAP.Core.Criteria.Function
@using Fanex.NAP.Core.Business
@model DuplicateFunctionCriteria
@{
    ViewBag.Title = ViewResources.Duplicate_Function;
    bool success = ViewBag.Success != null && ViewBag.Success;

    var viewFlags = (ViewFlags)ViewBag.ViewFlags;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title"><span class="first">@ViewResources.Function @ViewResources.Management
			/</span>
			@string.Format("Duplicate '{0}' Function", ViewBag.OriginFunctionName)
		</span>
		@if (Model.ReturnSiteId == null)
		{ 
			@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", null,
				new { @class = "lnk" })
		}
		else
		{
			@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", new { siteId = Model.ReturnSiteId },
				new { @class = "lnk" })
		}
	</h1>
}
@using (Html.BeginForm())
{
	<div class="form w120">
		<div class="form-row summary">
			<div class="lbl-field"></div>
			<div class="edit-field">
				@Html.ValidationSummary()
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.FunctionName, "Function Name:")
			</div>
			<div class="edit-field">
				@Html.Hidden("FunctionId", Model.FunctionId)
				@Html.TextBoxFor(m => m.FunctionName)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				<label class="read-only">@ViewResources.Site:</label>
			</div>
			<div class="edit-field">
				@Html.Hidden("SiteName", Model.SiteName)
				<label class="read-only">@Model.SiteName</label>
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.Description, "Description:")
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(m => m.Description)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.Readonly, "Readonly:")
			</div>
			<div class="edit-field rdo-field">
				@Html.CheckBoxFor(m => m.Readonly, new { disabled = "disabled" })
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.ParentId, "Parent:")
			</div>
			<div class="edit-field">
				@Html.DropDownListFor(m => m.ParentId, (List<SelectListItem>)ViewBag.FunctionList, ViewResources.None)
				@Html.HiddenFor(m => m.ParentName)
			</div>
		</div>
		<div class="form-row required">
			<div class="lbl-field">
				@Html.LabelFor(m => m.DisplayOrder, "Display Order:")
			</div>
			<div class="edit-field">
				@Html.TextBoxFor(m => m.DisplayOrder)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.IsActive, "Status:")
			</div>
			<div class="edit-field chk-field">
				@Html.CheckBoxFor(m => m.IsActive)
				@Html.LabelFor(m => m.IsActive, ViewResources.Active)
			</div>
		</div>
		@if (viewFlags.IsLive)
		{
			@Html.HiddenFor(m => m.Environment)
		}
		else
		{
			<div class="form-row">
				<div class="lbl-field">
					@Html.LabelFor(m => m.Environment, "Environment:")
				</div>
				<div class="edit-field rdo-field">
					@Html.RadioButtonFor(m => m.Environment, "UAT", new { id = "Environment-UAT" })
					@Html.Label("Environment-UAT", ViewResources.UAT)
					@Html.RadioButtonFor(m => m.Environment, "LIVE", new { id = "Environment-LIVE" })
					@Html.Label("Environment-LIVE", ViewResources.LIVE)
				</div>
			</div>
		}
		<div class="form-row">
			<div class="lbl-field">
			</div>
			<div class="edit-field">
				@if (!success)
				{
					<input type="submit" value="@ViewResources.Save" />
					<button class="cancel" onclick="NAP.redirect('Function/Manage?siteId=@Model.ReturnSiteId', 0); return false;">@ViewResources.Cancel</button>
				}
			</div>
		</div>
	</div>
	@Html.HiddenFor(m => m.ReturnSiteId)
}
@section Foot {
	<script src="~/Areas/UserControl/scripts/Function/Duplicate.js" type="text/javascript"></script>
	@if (success)
	{
		string dialogMsg = string.Format(ViewResources.AddSuccessMsg, ViewResources.Function + " '" + Model.FunctionName + "'", 3);

		<script type="text/javascript">
			$(function () {
				NAP.showSuccessMsg('@dialogMsg', 'Function/Manage?siteId=@Model.ReturnSiteId', 4000);
			});
		</script>
	}
}
