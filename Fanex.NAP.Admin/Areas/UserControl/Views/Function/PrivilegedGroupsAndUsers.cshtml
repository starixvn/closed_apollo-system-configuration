@{
	ViewBag.Title = ViewResources.Privileged_Groups_and_Users;

	var viewFlags = (ViewFlags)ViewBag.ViewFlags;
	var userList = (List<UserPolicy>)ViewBag.Users;
	var groupList = (List<GroupPolicy>)ViewBag.Groups;
	var function = (IFunction)ViewBag.Function;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/function/PrivilegedGroupsAndUsers.less"
		rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@ViewResources.Function @ViewResources.Management /</span>
			@string.Format("Privileged Groups and Users of '{0}' Function", function.Name)
		</span>
		@Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "Function", new { siteId = ViewBag.SiteId }, new { @class = "lnk" })
	</h1>
}
<div class="grid-wrp pnl-wrp">
	<div class="pnl-header">
		<div class="pnl-header-content"><span>@ViewResources.Group_List</span>
		@if (viewFlags.HasAssignFunctionToGroupRight)
		{
			<a href="javascript:;" id="btn-add-group" title="@ViewResources.Add_groups_to_list"></a>
		}
		</div>
		<div class="pnl-header-toggle"></div>
	</div>
	<div class="pnl-body">
		<table class="grid" id="group-grid">
			<thead>
				<tr>
					<th>
						#
					</th>
					<th>
						@ViewResources.Group_Name
					</th>
					<th>
						@ViewResources.Policy
					</th>
					<th>
						@ViewResources.Assigned_Date
					</th>
					<th>
						@ViewResources.Assigned_By
					</th>
			</thead>
			<tbody>
				@if (groupList != null && groupList.Count > 0)
				{
					int i = 0;
					foreach (GroupPolicy item in groupList)
					{
						string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
					<tr @Html.Raw(rowCss)>
						<td class="align-center">
							@(i + 1)
						</td>
						<td>
							@item.Group.Name
						</td>
						<td class="align-center">
							@if (item.Policy == (int)Constant.Policy.Host)
							{
								<span class="crud-host">@ViewResources.Host</span>
							}
							else
							{
								<span class="crud-read">@ViewResources.Read</span>
							}
						</td>
						<td>
							@Html.Raw(item.ModifiedDate.ToFullDateString())
						</td>
						<td>
							@(item.Creator != null ? item.Creator.Username : string.Empty)
						</td>
					</tr>
	
							i++;
					}
				}
				else
				{
					<tr>
						<td colspan="6" class="align-center">
							@ViewResources.NoInformationAvailable
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>
<br />
<div class="grid-wrp pnl-wrp">
	<div class="pnl-header">
		<div class="pnl-header-content"><span>@ViewResources.User_List</span>
		@if (viewFlags.HasAssignFunctionToUserRight)
		{
			<a href="javascript:;" id="btn-add-user" title="@ViewResources.Add_users_to_list"></a>
        }
        </div>
		<div class="pnl-header-toggle"></div>
	</div>
	<div class="pnl-body">
		<table class="grid" id="user-grid">
			<thead>
				<tr>
					<th>
						#
					</th>
					<th>
						@ViewResources.Username
					</th>
					<th>
						@ViewResources.First_Name
					</th>
					<th>
						@ViewResources.Last_Name
					</th>
					<th>
						@ViewResources.Email
					</th>
					<th>
						@ViewResources.Group
					</th>
					<th>
						@ViewResources.User @ViewResources.Policy
					</th>
					<th>
						@ViewResources.Group @ViewResources.Policy
					</th>
					<th>
						@ViewResources.Assigned_Date
					</th>
					<th>
						@ViewResources.Assigned_By
					</th>
				</tr>
			</thead>
			<tbody>
				@if (userList != null && userList.Count > 0)
    {
        int i = 0;
        foreach (var item in userList)
        {
            string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
            var groupPolicy = groupList == null || item.User.Group == null ? null
                : groupList.Where(g => g.Group.Id == item.User.Group.Id).FirstOrDefault();
		
					<tr @Html.Raw(rowCss)>
						<td class="align-center">
							@(i + 1)
						</td>
						<td>
							@item.User.Username
						</td>
						<td>
							@item.User.FirstName
						</td>
						<td>
							@item.User.LastName
						</td>
						<td>
							@item.User.Email
						</td>
						<td>
							@(item.User.Group != null ? item.User.Group.Name : string.Empty)
						</td>
						<td class="align-center">
							@if (item.Policy == (int)Constant.Policy.Host)
       {
								<span class="crud-host">@ViewResources.Host</span>
       }
       else
       {
								<span class="crud-read">@ViewResources.Read</span>
       }
						</td>
						<td class="align-center">
							@if (groupPolicy != null)
       {
           if (groupPolicy.Policy == (int)Constant.Policy.Host)
           {
								<span class="crud-host">@ViewResources.Host</span>
           }
           else
           {
								<span class="crud-read">@ViewResources.Read</span>
           }
       }
						</td>
						<td>
							@Html.Raw(item.ModifiedDate.ToFullDateString())
						</td>
						<td class="align-center">
							@(item.Modifier != null ? item.Modifier.Username : string.Empty)
						</td>
					</tr>
		
       i++;
        }
    }
    else
    {
					<tr>
						<td colspan="10" class="align-center">
							@ViewResources.NoInformationAvailable
						</td>
					</tr>
    }
			</tbody>
		</table>
	</div>
</div>

<div id="add-group-box" style="display: none">
	<div class="filter-form">
		<div class="filter-row">
			<div class="filter-cell">
				<div class="lbl-field width-auto">
					@Html.Label(ViewResources.Group_Name)
				</div>
				<div class="edit-field">
					<input type="text" name="Groupname" />
				</div>
			</div>
			<div class="filter-cell">
				<div class="submit">
					<input type="submit" value="@ViewResources.Search" name="group" />
				</div>
			</div>
		</div>
	</div>
</div>

<div id="add-user-box" style="display: none">
	<div class="filter-form">
		<div class="filter-row">
			<div class="filter-cell">
				<div class="lbl-field width-auto">
					@Html.Label(ViewResources.Username)
				</div>
				<div class="edit-field">
					<input type="text" value="" name="Username" />
				</div>
			</div>
			<div class="filter-cell">
				<div class="lbl-field col_1">
					@Html.Label("GroupId", ViewResources.Group, new { id = string.Empty })
				</div>
				<div class="edit-field">
					@Html.DropDownList("GroupId", (List<SelectListItem>)ViewBag.GroupSelectList, ViewResources.All_Groups)
				</div>
			</div>
			<div class="filter-cell">
				<div class="submit">
					<input type="submit" value="@ViewResources.Search" name="user" />
				</div>
			</div>
		</div>
	</div>
</div>

@Html.Hidden("fid", function.Id)
@Html.Hidden("fname", function.Name)
@section Foot {
	<script src="~/Areas/UserControl/scripts/Function/PrivilegedGroupsAndUsers.js" type="text/javascript"></script>
}
