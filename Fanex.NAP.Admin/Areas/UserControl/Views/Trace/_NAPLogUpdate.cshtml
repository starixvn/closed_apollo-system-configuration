@{
    Layout = null;
    var listData = (List<LogData>)ViewBag.LogData ?? new List<LogData>();      
}
@model List<LogData>
<div class="grid-wrp pnl-wrp">
    <div class="pnl-header">
        <div class="pnl-header-content">&nbsp;</div>
    </div>
    <div class="pnl-body">
        <table class="grid">
            <thead>
                <tr>
                    <th>
                        @ViewResources.Field_Name
                    </th>
                    <th>
                        @ViewResources.Old_Value
                    </th>
                    <th>
                        @ViewResources.New_Value
                    </th>
                </tr>
            </thead>
            <tbody>
                @{
                    int i = 0;
                    foreach (var item in listData)
                    {
                        string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";
		
                    <tr @Html.Raw(rowCss)>
                        <td>
                            @item.FieldName
                        </td>
                        <td>
                            @item.OldValue
                        </td>
                        <td @(item.OldValue != item.NewValue ? "class=log-status" : string.Empty)>
                            @item.NewValue
                        </td>
                    </tr>
                        i++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>
