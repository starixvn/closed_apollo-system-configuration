@using Fanex.NAP.Core.Criteria.Trace
@using System.Globalization
@model GetAllLogUserLoginCriteria
@{
    ViewBag.Title = ViewResources.Log_Management;
    var listLog = (PagerList<LogUserLogin>)ViewBag.ListLog;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/trace/logexecsp.less" rel="stylesheet"
        type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.Log_Management / </span>
            @ViewResources.User_Login_Log
        </span>
    </h1>
}
<section id="filter-bar">
    @using (Html.BeginForm())
    {
        <div class="filter-form">
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.Name)
            </div>
            <div class="edit-field">
                @Html.TextBoxFor(m => m.Name)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.From)
            </div>
            <div class="edit-field relative">
                @Html.EditorFor(m => m.From)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.To)
            </div>
            <div class="edit-field relative">
                @Html.EditorFor(m => m.To)
            </div>
            <div class="lbl-field width-auto">
                @Html.LabelFor(m => m.SiteId)
            </div>
            <div class="edit-field">
                @Html.DropDownListFor(m => m.SiteId, (List<SelectListItem>)ViewBag.ListSite)
            </div>
            <div class="submit">
                <input type="submit" value="@ViewResources.Submit" />
            </div>
        </div>
        @Html.HiddenFor(m => m.PageIndex)
        @Html.HiddenFor(m => m.PageSize)
    }
</section>
<div class="grid-wrp pnl-wrp">
    <div class="pnl-header">
        <div class="pnl-header-content">
            &nbsp;</div>
        <div class="pnl-header-toggle">
        </div>
    </div>
    <div class="pnl-body">
        <table class="grid">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>
                        @ViewResources.Log_ID
                    </th>
                    <th>
                        @ViewResources.Log_Date
                    </th>
                    <th>
                        @ViewResources.User
                    </th>
                    <th>
                        @ViewResources.IP
                    </th>
                    <th>
                        @ViewResources.Site
                    </th>
                    <th>
                        @ViewResources.Domain_Name
                    </th>
                    <th>
                        @ViewResources.Browser_Name
                    </th>
                    <th>
                        @ViewResources.Platform
                    </th>
                    <th>
                        @ViewResources.Country_Code
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (!ReferenceEquals(listLog, null) && listLog.Count() > 0)
                {
                    int i = 0;
                    foreach (var item in listLog)
                    {
                        string rowCss = i % 2 == 0 ? string.Empty : "class='alt'";

                    <tr @Html.Raw(rowCss)>
                        <td class="align-center">
                            @((i + 1) + ((Model.PageIndex - 1) * Model.PageSize))
                        </td>
                        <td>
                            @item.Id
                        </td>
                        <td style="width: 150px" class="align-center">
                            @item.LogDate.ToFullDateString()
                        </td>
                        <td style="width: 200px">
                            @item.User.Username
                        </td>
                        <td style="width: 200px">
                            @item.IP
                        </td>
                        <td style="width: 200px">
                            @if (item.Site.Id != 0)
                            { 
                                @item.Site.Name
                            }
                            else
                            {
                                @ViewResources.NAP_Hub
                            }
                        </td>
                        <td>
                            @item.DomainName
                        </td>
                        <td>
                            @item.BrowserName
                        </td>
                        <td>
                            <span title="@item.Platform">
                                @item.Platform.GetOperatingSystem()
                            </span>
                        </td>
                        <td>
                            @item.CountryCode.GetGeoName()
                        </td>
                    </tr>
                            i++;
                    }
                }
                else
                {
                    <tr class="no-info">
                        <td colspan="12" class="align-center">
                            @ViewResources.NoInformationAvailable
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="12">
                        @if (listLog != null && listLog.Count() > 0)
                        {
                            <span class="items-per-page-wrp">@ViewResources.Show
                                @Html.DropDownList("items-per-page", new List<SelectListItem> { 
							new SelectListItem { Value = "10", Text = "10", Selected = "10" == Model.PageSize.ToString() }, 
							new SelectListItem { Value = "20", Text = "20", Selected = "20" == Model.PageSize.ToString() }, 
							new SelectListItem { Value = "30", Text = "30", Selected = "30" == Model.PageSize.ToString() } 
						}, new { id = string.Empty, @class = "items-per-page" })</span>
                            @Html.Pager(listLog, new PagerOptions()
                {
                    PageIndexParameterName = "id",
                    ShowFirstLast
                        = true,
                    CurrentPagerItemWrapperFormatString = "<a class='jp-current'>{0}</a>"
                }, new { @class = "jpages" })
                        }
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
@Html.Hidden("imagePath", Url.Content("~/Areas/UserControl/themes/nap/img/calendar.gif"))
@section Foot {
    <script src="~/Areas/UserControl/scripts/Trace/LogUserLogin.js" type="text/javascript"></script>
}
