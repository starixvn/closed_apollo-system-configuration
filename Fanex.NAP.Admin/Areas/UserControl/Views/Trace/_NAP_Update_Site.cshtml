@{
    var newSite = ViewBag.NewSite as SiteLevel;
    var oldSite = ViewBag.OldSite as SiteLevel;
}

@if (oldSite != null)
{
    <br />
    <h1>Site Old Value</h1>
    <br />
    
    <div class="grid-wrp pnl-wrp">
            <div class="pnl-header">
                <div class="pnl-header-content"></div>
            </div>
            <div class="pnl-body">
                <table class="grid">
                    <thead>
                            <tr>
                                <th>
	                                @ViewResources.Site_Name
                                </th>
                                <th>
	                                @ViewResources.Level
                                </th>
                                <th>
	                                @ViewResources.Active
                                </th>
                            </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@oldSite.Site.Name</td>
                            <td class="align-center">@oldSite.Level.ToUserLevel()</td>
                            <td class="align-center">
                                 @if (oldSite.IsActive)
                                 {
                                     <img class="ico-tick" alt="" src="/NAPAdmin/areas/usercontrol/themes/nap/img/blank.png" />
                                 }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
     </div>
}

@if (newSite != null)
{
    <br />
    <h1>Site New Value</h1>
    <br />
    
    <div class="grid-wrp pnl-wrp">
            <div class="pnl-header">
                <div class="pnl-header-content">  </div>
            </div>
            <div class="pnl-body">
                <table class="grid">
                    <thead>
                            <tr>
                                <th>
	                                @ViewResources.Site_Name
                                </th>
                                <th>
	                                @ViewResources.Level
                                </th>
                                <th>
	                                @ViewResources.Active
                                </th>
                            </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@newSite.Site.Name</td>
                            <td class="align-center">@newSite.Level.ToUserLevel()</td>
                            <td class="align-center">
                                 @if (newSite.IsActive)
                                 {
                                     <img class="ico-tick" alt="" src="/NAPAdmin/areas/usercontrol/themes/nap/img/blank.png" />
                                 }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
     </div>
}
