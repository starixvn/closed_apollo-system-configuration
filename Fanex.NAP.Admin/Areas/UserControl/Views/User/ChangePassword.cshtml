@using Fanex.NAP.Core.Criteria.User
@model UpdatePasswordCustCriteria
@{
	ViewBag.Title = ViewResources.Change_Password;
	bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
	<link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
	<h1>
		<span class="title">
			<span class="first">@HttpContext.Current.User.Identity.Name / </span>
			@ViewResources.Change_Password
		</span>
	</h1>
}
@using (Html.BeginForm())
{
	<div class="form w120">
		<div class="form-row summary">
			<div class="lbl-field"></div>
			<div class="edit-field">
				@Html.ValidationSummary()
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.OldUserPwd)
			</div>
			<div class="edit-field">
				@Html.PasswordFor(m => m.OldUserPwd)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.UserPwd)
			</div>
			<div class="edit-field">
				@Html.PasswordFor(m => m.UserPwd)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field">
				@Html.LabelFor(m => m.ConfirmUserPwd)
			</div>
			<div class="edit-field">
				@Html.PasswordFor(m => m.ConfirmUserPwd)
			</div>
		</div>
		<div class="form-row">
			<div class="lbl-field"></div>
			<div class="edit-field">
				<input type="submit" value="@ViewResources.Save" />
				<button class="cancel" onclick="NAP.navigateToRoot('', 0); return false;">@ViewResources.Cancel</button>
			</div>
		</div>
	</div>
}
@section Foot {
	@if (success)
	{
		<script type="text/javascript">
			$(function () {
				NAP.headlineMsgBox.showInfo('@ViewResources.Your_changes_were_saved!', { closeBtn: false });
			});
		</script>
	}
}