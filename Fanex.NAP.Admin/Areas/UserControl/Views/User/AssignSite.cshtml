@{
    var viewFlags = (ViewFlags)ViewBag.ViewFlags;

    ViewBag.Title = ViewResources.NAP_Admin;
    string headline = viewFlags.HasAssignSiteRight
        ? string.Format("Assign Site to User '{0}'", ViewBag.Username)
        : string.Format("Sites of User '{0}'", ViewBag.Username);

    var level = ViewBag.Level != null ? (int)ViewBag.Level : 0;
    var isSelftEdit = ViewBag.IsSelfEdit != null ? (bool)ViewBag.IsSelfEdit : false;
    var isPortalAdmin = ViewBag.IsPortalAdmin != null ? (bool)ViewBag.IsPortalAdmin : false;
    var siteList = ViewBag.SiteList as List<ISite>;                 // list of site which current login user has Assign User To Site permission
    var editableSiteList = ViewBag.EditableSiteList as List<ISite>; // list of site which current login user has Assign User To Site "Host" permission
    var siteLevelList = ViewBag.SiteLevelList as List<SiteLevel>;
    var currentUserSiteLevelList = ViewBag.CurrentUserSiteLevelList as List<SiteLevel>;
    var currentSiteId = ViewBag.CurrentSiteId != null ? (int)ViewBag.CurrentSiteId : 0;
}

@section Head {
    <link href="~/Areas/UserControl/themes/nap/user/assign-site.less" rel="stylesheet" type="text/css" /> 
}

@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.User_Management /</span>
            @headline
        </span>
        @if (viewFlags.HasAssignSiteRight && ViewBag.UserId != null)
        {
            @Html.ActionLink("+ " + ViewResources.AssignNewSite, "GetAvailableSitesForUser", "User",
                new
                {
                    userId = ViewBag.UserId,
                    username = ViewBag.Username,
                    siteId = ViewBag.SiteId,
                    groupId = ViewBag.ReturnGroupId,
                    pageIndex = ViewBag.PageIndex,
                    level = level
                }, new { @class = "lnk" })
        }
        
        @if (ViewBag.SiteId == null)
        { 
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
        }
        else
        {
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User",
                new
                {
                    siteId = ViewBag.SiteId,
                    id = ViewBag.PageIndex,
                    groupId = ViewBag.ReturnGroupId
                }, new { @class = "lnk" })
        }
    </h1>
}

@Html.Hidden("UserId", (int)ViewBag.UserId)
@Html.Hidden("HasAssignSiteRight", viewFlags.HasAssignSiteRight)

<div class="grid-wrp pnl-wrp no-scale">
    <div class="pnl-header">
        <div class="pnl-header-content"></div>
        <div class="pnl-header-toggle"></div>
    </div> 
    <div class="pnl-body">
            <table class="grid no-scale">
                <thead>
                    <tr>
                        <th>
                            #
                        </th>
                        <th>
                            @ViewResources.Site
                        </th>
                        <th>
                            @ViewResources.Level
                        </th>
                        <th>
                            @ViewResources.Active
                        </th>
                        @if (viewFlags.HasAssignSiteRight)
                        {
                            <th>
                            @ViewResources.Edit
                            </th>
                        } 
                    </tr>
                </thead>
                <tbody>
                    @if (siteLevelList != null && siteLevelList.Any())
                    {
                        var index = 1;
                        var isChecked = false;
                        var isEnabled = false;
                        string checkedAttribute = string.Empty;
                        string disabledAttribute = string.Empty;
                        string disabledClass = string.Empty;
                        string userSelected = string.Empty;
                        bool hasRenderHtml = false;

                        foreach (var siteLevel in siteLevelList)
                        {
                            isChecked = siteLevel != null && siteLevel.IsActive;
                            var hasHostRightInSiteOfLoginUser = editableSiteList != null && editableSiteList.Count(s => s.Id == siteLevel.Site.Id)  > 0;
                            var isSelectedUserInSite = siteLevel.Level == (int)Constant.Level.User;

                            if (!isSelftEdit)                   // if user is not edit himself
                            {
                                var site = siteList.Where(s => s.Id == siteLevel.Site.Id).FirstOrDefault();

                                if (site != null)               // if siteLevel is belong to list site has Assign Site to User
                                {
                                    var currentUserSiteLevel = currentUserSiteLevelList.Where(s => s.Site.Id == siteLevel.Site.Id).FirstOrDefault();

                                    isEnabled = (isPortalAdmin && (siteLevel == null || siteLevel.Level < (int)Constant.Level.PortalAdmin))		// portal admin
                                            ||
                                            (viewFlags.HasAssignSiteRight && currentUserSiteLevel != null		// have edit right and greater level in that site
                                                && hasHostRightInSiteOfLoginUser && currentUserSiteLevel.IsActive &&
                                                (siteLevel == null || currentUserSiteLevel.Level > siteLevel.Level
                                                || (currentUserSiteLevel.Level == (int)Constant.Level.User && isSelectedUserInSite)
                                                )
                                            );
                                    userSelected = isChecked && siteLevel.Level == (int)Constant.Level.User
                                                                ? "selected=\"selected\"" : string.Empty;
                                    hasRenderHtml = true;
                                }
                            }
                            else
                            {
                                isEnabled = (currentSiteId != siteLevel.Site.Id) 
                                        && (isPortalAdmin || (isChecked && hasHostRightInSiteOfLoginUser && isSelectedUserInSite));
                                hasRenderHtml = true;
                            }

                            if (hasRenderHtml)
                            {
                                checkedAttribute = isChecked ? "checked=\"checked\"" : string.Empty;
                                disabledAttribute = !isEnabled ? "disabled=\"disabled\"" : string.Empty;
                                disabledClass = !isEnabled ? "disabled" : string.Empty;

                                <tr>
                                    <td class="align-center">
                                        @index
                                    </td>
                                    <td>
                                        <span id="lbSite_@siteLevel.Site.Id">@siteLevel.Site.Name</span>
                                    </td>
                                    <td class="align-center">
                                        <span id="lbLevel_@siteLevel.Site.Id">
                                            @siteLevel.Level.ToUserLevel()
                                        </span>
                                        <select id="ddlSiteLevel_@siteLevel.Site.Id" style="display: none;">
                                            <option value="0" @Html.Raw(userSelected)>@ViewResources.User</option>
                                            @if (level > (int)Constant.Level.SiteAdmin)
                                            {
                                                string siteAdminSelected = isChecked && siteLevel.Level == (int)Constant.Level.SiteAdmin
                                                                    ? "selected=\"selected\"" : string.Empty;
                                                <option value="50" @Html.Raw(siteAdminSelected)>@ViewResources.Site_Admin</option>
                                            }
                                        </select>
                                    </td>

                                    @if (viewFlags.HasAssignSiteRight)
                                    {
                                        <td class="align-center">
                                            <input type="checkbox" id="chbSite_@siteLevel.Site.Id" class="chbSite" name="@siteLevel.Site.Name"
                                                value="@siteLevel.Level" @Html.Raw(checkedAttribute) @Html.Raw(disabledAttribute) />
                                        </td>
                                    }
                                    else if (viewFlags.HasAssignSiteReadRight)
                                    {
                                        if (isChecked)
                                        {
                                            <td class="align-center">
                                                <img class="ico-tick" alt="" src=""/>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="align-center"></td>
                                        }
                                    }

                                    @if (viewFlags.HasAssignSiteRight)
                                    {
                                        <td>
                                            <a class="btn-edit @Html.Raw(disabledClass)" href="javascript:;"></a>
                                            <a class="btn-apply" href="javascript:;" style="display:none;">@ViewResources.OK</a>
                                            <a class="btn-cancel" href="javascript:;" style="display:none;">@ViewResources.Cancel</a>
                                        </td>
                                    }
                                </tr>
                            }

                            hasRenderHtml = false;
                            index++;
                            }
                        }
                </tbody>
            </table>
      </div>
</div>
@section Foot {
    <script src="~/Areas/UserControl/scripts/User/AssignSite.js" type="text/javascript"></script>
}
