@{
    var viewFlags = (ViewFlags)ViewBag.ViewFlags;

    ViewBag.Title = ViewResources.NAP_Admin;
    string headline = viewFlags.HasAssignSiteRight
        ? string.Format("Assign Site to User '{0}'", ViewBag.Username)
        : string.Format("Sites of User '{0}'", ViewBag.Username);

    var level = ViewBag.Level != null ? (int)ViewBag.Level : 0;
    var isSelftEdit = ViewBag.IsSelfEdit != null ? (bool)ViewBag.IsSelfEdit : false;
    var isPortalAdmin = ViewBag.IsPortalAdmin != null ? (bool)ViewBag.IsPortalAdmin : false;
    int NapAdminId = 1;
    var siteList = ViewBag.SiteList as List<ISite>;                 // list of site which current login user has Assign User To Site permission
    var editableSiteList = ViewBag.EditableSiteList as List<ISite>; // list of site which current login user has Assign User To Site "Host" permission
    var siteLevelList = ViewBag.SiteLevelList as List<SiteLevel>;
    var currentUserSiteLevelList = ViewBag.CurrentUserSiteLevelList as List<SiteLevel>;
    var currentSiteId = ViewBag.CurrentSiteId != null ? (int)ViewBag.CurrentSiteId : 0;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/user/assign-site.less" rel="stylesheet"
        type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.User_Management /</span>
            @headline
        </span>
        @if (ViewBag.SiteId == null)
        { 
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
        }
        else
        {
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User",
                new
                {
                    siteId = ViewBag.SiteId,
                    id = ViewBag.PageIndex,
                    groupId = ViewBag.ReturnGroupId
                }, new { @class = "lnk" })
        }
    </h1>
}
@Html.Hidden("UserId", (int)ViewBag.UserId)
@Html.Hidden("HasAssignSiteRight", viewFlags.HasAssignSiteRight)
<div class="form">
    @using (Html.BeginForm())
    {
        <div class="form-row">
            <table class="grid no-scale">
                <thead>
                    <tr>
                        <th>
                            @ViewResources.Active
                        </th>
                        <th>
                            @ViewResources.Site_Name
                        </th>
                        <th>
                            @ViewResources.Level
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (siteList != null && siteList.Any())
                    {
                        foreach (var site in siteList)
                        {
                            var siteLevel = siteLevelList.Where(s => s.Site.Id == site.Id).FirstOrDefault();
                            var currentUserSiteLevel = currentUserSiteLevelList.Where(s => s.Site.Id == site.Id).FirstOrDefault();
                            var isChecked = siteLevel != null;
                            var isEnabled = (currentSiteId != site.Id || !isSelftEdit) &&		// not current site self edit
                                ((isPortalAdmin && (siteLevel == null || siteLevel.Level < (int)Constant.Level.PortalAdmin))		// portal admin
                                || (viewFlags.HasAssignSiteRight && currentUserSiteLevel != null		// have edit right and greater level in that site
                                && editableSiteList != null && editableSiteList.Count(s => s.Id == site.Id) > 0 &&
                                (siteLevel == null || currentUserSiteLevel.Level > siteLevel.Level
                                || (currentUserSiteLevel.Level == (int)Constant.Level.User && siteLevel.Level == (int)Constant.Level.User))));
                            var isEnabledLevel = isEnabled && isChecked;
                            string checkedAttribute = isChecked ? "checked=\"checked\"" : string.Empty;
                            string disabledAttribute = !isEnabled ? "disabled=\"disabled\"" : string.Empty;
                            string disabledAttributeLevel = !isEnabledLevel ? "disabled=\"disabled\"" : string.Empty;
                            string userSelected = isChecked && siteLevel.Level == (int)Constant.Level.User
                                ? "selected=\"selected\"" : string.Empty;
					
                        <tr>
                            <td class="align-center">
                                <input type="checkbox" id="chbSite_@site.Id" class="chbSite" @Html.Raw(checkedAttribute) @Html.Raw(disabledAttribute) />
                            </td>
                            <td>
                                <label for="chbSite_@site.Id">@site.Name</label>
                            </td>
                            <td class="align-center">
                                <select id="ddlSiteLevel_@site.Id" @Html.Raw(@disabledAttributeLevel) style="width: 100px">
                                    <option value="@((int)Constant.Level.User)" @Html.Raw(userSelected)>@ViewResources.User</option>
                                    @if (level > (int)Constant.Level.SiteAdmin
                                    || (isChecked && siteLevel.Level == (int)Constant.Level.SiteAdmin))	// current login user level > User
                                    {
                                        string siteAdminSelected = isChecked && siteLevel.Level == (int)Constant.Level.SiteAdmin
                                            ? "selected=\"selected\"" : string.Empty;

                                        <option value="@((int)Constant.Level.SiteAdmin)" @Html.Raw(siteAdminSelected)>@ViewResources.Site_Admin</option>

                                        if (site.Id == NapAdminId && isChecked && siteLevel.Level == (int)Constant.Level.PortalAdmin)	// selected user level is Portal Admin
                                        {
                                            string portalAdminSelected = isChecked && siteLevel.Level == (int)Constant.Level.PortalAdmin
                                                ? "selected=\"selected\"" : string.Empty;

                                        <option value="@((int)Constant.Level.PortalAdmin)" @Html.Raw(portalAdminSelected)>@ViewResources.Portal_Admin</option>
                                        }
                                    }
                                </select>
                            </td>
                        </tr>
                        }
                    }
                    @if (isSelftEdit)
                    {
                        foreach (var site in currentUserSiteLevelList)
                        {
                            if (siteList == null || siteList.Count(s => s.Id == site.Site.Id) == 0)
                            {
                                string userSelected = site.Level == (int)Constant.Level.User
                                    ? "selected=\"selected\"" : string.Empty;
                        <tr>
                            <td class="align-center">
                                <input type="checkbox" id="chbSite_@site.Site.Id" class="chbSite" checked="checked" disabled="disabled" />
                            </td>
                            <td>
                                <label for="chbSite_@site.Site.Id">@site.Site.Name</label>
                            </td>
                            <td class="align-center">
                                <select id="ddlSiteLevel_@site.Site.Id" disabled="disabled" style="width: 100px">
                                    <option value="@((int)Constant.Level.User)" @Html.Raw(userSelected)>@ViewResources.User</option>
                                </select>
                            </td>
                        </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
                    if (isPortalAdmin || viewFlags.HasAssignSiteRight)
                    {
        <div class="form-row">
            <div class="edit-field">
                <input type="submit" value="@ViewResources.Save" id="btn-submit" />
                <button class="cancel" onclick="NAP.redirect('User/Manage/@ViewBag.PageIndex?siteId=@ViewBag.SiteId&groupId=@ViewBag.ReturnGroupId', 0); return false;">@ViewResources.Cancel</button>
            </div>
        </div>
                    }
    }
</div>
@section Foot {
    <script src="~/Areas/UserControl/scripts/User/AssignSite.js" type="text/javascript"></script>
}
