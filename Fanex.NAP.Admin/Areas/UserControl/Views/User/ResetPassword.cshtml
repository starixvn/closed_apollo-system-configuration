@using Fanex.NAP.Core.Criteria.User
@model ResetPasswordCustCriteria
@{
    ViewBag.Title = ViewResources.Reset_Password;
    bool success = ViewBag.Success != null && ViewBag.Success;
}
@section Head {
    <link href="~/Areas/UserControl/themes/nap/style.less" rel="stylesheet" type="text/css" />
}
@section Headline {
    <h1>
        <span class="title"><span class="first">@ViewResources.User_Management /</span>
            @ViewBag.Title
        </span>
        @if (Model.SiteId == null)
        { 
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User", null, new { @class = "lnk" })
        }
        else
        {
            @Html.ActionLink("← " + ViewResources.Back_To_List, "Manage", "User",
                new
                {
                    siteId = Model.SiteId,
                    id = Model.PageIndex,
                    groupId = Model.ReturnGroupId
                }, new { @class = "lnk" })
        }
    </h1>
}
@using (Html.BeginForm())
{
    @Html.HiddenFor(c => c.CustId)
    @Html.HiddenFor(m => m.ReturnGroupId)
    <div class="form w140">
        <div class="form-row summary">
            <div class="lbl-field"></div>
            <div class="edit-field">
                @Html.ValidationSummary()
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
                @Html.LabelFor(m => m.CustId, "Username:", new { @class = "read-only" })
            </div>
            <div class="edit-field">
                @Html.Label(Model.Username, new { @class = "read-only bold" })
                @Html.HiddenFor(m => m.Username)
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(c => c.UserPwd, "New Password:")
            </div>
            <div class="edit-field">
                @Html.PasswordFor(c => c.UserPwd)
            </div>
        </div>
        <div class="form-row required">
            <div class="lbl-field">
                @Html.LabelFor(c => c.ConfirmUserPwd, "Confirm Password:")
            </div>
            <div class="edit-field">
                @Html.PasswordFor(c => c.ConfirmUserPwd)
            </div>
        </div>
        <div class="form-row">
            <div class="lbl-field">
            </div>
            <div class="edit-field">
                @if (!success)
                {
                    <input type="submit" value="@ViewResources.Save" />
                    <button class="cancel" onclick="NAP.redirect('User/Manage/@Model.PageIndex?siteId=@Model.SiteId&groupId=@Model.ReturnGroupId', 0); return false;">@ViewResources.Cancel</button>
                }
            </div>
        </div>
    </div>
}
@section Foot
{
    @if (success)
    {
        string dialogMsg = string.Format(ViewResources.ResetPwdSuccessMsg, Model.Username, 3);

        <script type="text/javascript">
            $(function () {
                NAP.showSuccessMsg('@dialogMsg', 'User/Manage/@Model.PageIndex?siteId=@Model.SiteId&groupId=@Model.ReturnGroupId', 4000);
            });
        </script>
    }
}