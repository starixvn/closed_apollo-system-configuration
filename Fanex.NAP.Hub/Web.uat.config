<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=152368
  -->
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="dotless" type="dotless.Core.configuration.DotlessConfigurationSectionHandler, dotless.Core" />
    <section name="NapSettings" type="Fanex.NAP.Core.Configuration.NapSettings, Fanex.NAP.Core" />
  </configSections>

  <NapSettings Environment="UAT"
  UMAddress="http://10.103.181.1:8088/Home/jsonUM"
  EnableDirectLogin="false"
  SiteId="0"
  EnableCheckUM="1"
  EnableReCheckin="1"
  HubUrl="http://csd.sunsport77.com/Hub/UserLogin"
  UnauthorizeUrl="~/UserLogin/Common/AccessDenied">
    <Domain>
      <add Name="csd.sunsport77.com" Path="/Hub" />
    </Domain>
  </NapSettings>

  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider2,Fanex.Data" resourcePath="~/App_Data/uat/" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.40.41.11\private$\entlib" defaultCategory="CSD" />
  <appSettings>
    <add key="webpages:Version" value="2.0.0.0" />
    <add key="webpages:Enabled" value="true" />
    <add key="PreserveLoginUrl" value="true" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="Environment" value="LIVE" />
    <add key="IsSiteLogin" value="0" />
    <add key="SiteId" value="0" />
  </appSettings>
  <connectionStrings configSource="Web.ConnectionString.config" />
  <system.web>
    <compilation debug="false" targetFramework="4.0" />

    <authentication mode="Forms">
      <forms ticketCompatibilityMode="Framework40" cookieless="UseCookies" loginUrl="~/UserLogin/Login" timeout="2880" defaultUrl="~/UserLogin/UserSite/Site"></forms>
    </authentication>
    <sessionState mode="StateServer" stateConnectionString="tcpip=10.40.41.112:42424" timeout="120" cookieless="false" />
    <!--<authorization>
            <deny users="?" />
        </authorization>-->
    <customErrors mode="Off" defaultRedirect="~/Common/Error/">
      <!--<error statusCode="403" redirect="~/User/Unauthorize/" />
            <error statusCode="404" redirect="~/Common/NotFound/" /> -->
    </customErrors>
    <pages>
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Routing" />
        <add namespace="System.Web.WebPages" />
      </namespaces>
    </pages>

    <httpHandlers>
      <add path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler, dotless.Core" />
    </httpHandlers>
    <machineKey decryptionKey="F229DC7FA3D836A9916E7EE0211229A90AEC0A317618D3B4,IsolateApps" validationKey="1338C5A156876EB8DE76576BDC8F6B00B677D77B8968B626E75840C032A1436C362E418808576876DCF6E4FE1E28226012CA24A59FD8A5ABD7A00ADAC8ADC280,IsolateApps" />
  </system.web>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <add name="dotless" path="*.less" verb="GET" type="dotless.Core.LessCssHttpHandler,dotless.Core" resourceType="File" preCondition="" />
    </handlers>
    <staticContent>
      <mimeMap fileExtension=".less" mimeType="text/css" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-4.0.0.0" newVersion="4.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="NPOI" publicKeyToken="0df73ec7942b34e1" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-1.2.5.0" newVersion="1.2.5.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <location path="Areas/UserLogin/Themes">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <dotless minifyCss="true" cache="true" web="false" />
</configuration>